; Godot 4 project file. Kept minimal and hand-editable so that diffs stay
; reviewable. Do not let the editor add rendering or import settings that are
; not actually needed.

config_version=5

[application]

config/name="Yet-to-be JoJo's RPG"
config/description="Turn-based RPG with a deterministic Rust simulation core."
run/main_scene="res://scenes/battle_view.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

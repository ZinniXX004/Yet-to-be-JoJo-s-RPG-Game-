#!/bin/sh
# Pre-push hook: the fast local gate, then Git LFS.
#
# Enable once per clone (it is not enabled by cloning):
#   git config core.hooksPath .githooks
#
# core.hooksPath replaces .git/hooks entirely, which is why this directory also
# carries the three Git LFS hooks (post-checkout, post-commit, post-merge) that
# `git lfs install` would otherwise have written there, and why this file ends
# with the LFS pre-push call. Removing any of them silently breaks LFS.
#
# Only the fast gate runs here: formatting, content plus the probe mirror, and
# spelling. Those three are every check that has failed in CI so far, and they
# take seconds. Clippy and tests stay with `sh tools/check.sh` before a PR and
# with CI, because a hook slow enough to annoy is a hook that gets bypassed.
#
# Bypass for one push, knowingly:  git push --no-verify

root=$(git rev-parse --show-toplevel) || exit 1

# stdin carries the ref list git lfs pre-push needs below; keep it away from
# the gate so nothing in it can consume it.
if ! sh "$root/tools/check.sh" --fast < /dev/null; then
  printf >&2 '\npre-push: local gate failed; nothing was pushed. (git push --no-verify to override)\n'
  exit 1
fi

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove the LFS call from .githooks/pre-push."; exit 2; }
git lfs pre-push "$@"

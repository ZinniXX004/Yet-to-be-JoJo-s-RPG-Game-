# ---------- Godot 4 ----------
.godot/
export_presets.cfg
*.translation

# Godot 3 legacy import cache
.import/

# Compiled GDExtension binaries are build output, not source
src/game/bin/

# ---------- Rust ----------
# Match target/ at any depth (workspace members each have one)
**/target/
**/*.rs.bk
*.pdb

# NOTE: Cargo.lock is intentionally NOT ignored.
# This repo builds a binary (a game), so the lockfile must be committed
# to keep builds reproducible across machines and CI.

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---------- Editors / OS ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------- Build output ----------
/build/
/builds/
/dist/
*.apk
*.aab

# ---------- Balance harness output ----------
# Written by `cargo run -p rpg-core --bin balance -- --json > ../balance-report.json`.
# A saved report describes one working copy at one moment; the branch it is
# read on may no longer produce it. Measurements that are worth keeping go in
# docs/BALANCE-LOG.md and docs/BALANCE-CURVE.md, with the commit they came from.
balance-report.json
